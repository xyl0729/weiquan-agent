LLM_PROVIDER=fake
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1

# Optional cost accounting (USD / 1M tokens). Leave both blank until verified.
DEEPSEEK_PRICE_INPUT_PER_MILLION=
DEEPSEEK_PRICE_OUTPUT_PER_MILLION=

# Existing server-usage controls. The consult API never accepts a model key
# in its JSON body or request headers.
KEY_MODE=server
SERVER_API_KEY=
FREE_QUOTA_PER_DAY=2
DAILY_SPEND_LIMIT_USD=5.0

DB_PATH=./data/app.db
STATUTES_DB_PATH=./data/statutes.db
PLAYBOOK_DIR=./app/playbooks
TEMPLATE_DIR=./app/rendering/templates
JURISDICTION_CONFIG_PATH=./app/jurisdiction/data.yaml
RETRIEVAL_MODE=bm25
CORS_ORIGINS=http://localhost:8000
SESSION_TTL_HOURS=72
DEFAULT_JURISDICTION=
MAX_MESSAGE_LENGTH=4000
CLASSIFICATION_MIN_CONFIDENCE=0.45
